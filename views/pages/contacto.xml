<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="t4_contacto_page" name="Taller4 — Contacto">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'contacto'"/>
            <div id="wrap" class="t4-site">
                <section class="t4-contact">
                    <div class="t4-contact-inner">
                        <nav class="t4-breadcrumb">
                            <a href="/taller4">Inicio</a>
                            <span class="sep">/</span>
                            <span class="current">Contacto</span>
                        </nav>

                        <h1 class="t4-contact-title">CONTACTO</h1>
                        <hr class="t4-contact-divider"/>

                        <div class="t4-contact-grid">
                            <!-- Columna izquierda: datos + mapa -->
                            <div class="t4-contact-info">
                                <div class="t4-contact-block">
                                    <h3>Email</h3>
                                    <p><a href="mailto:contacto@taller4.cl">contacto@taller4.cl</a></p>
                                </div>

                                <div class="t4-contact-block">
                                    <h3>Dirección</h3>
                                    <p>Luis Pasteur 6677 local 4, Vitacura.</p>
                                </div>

                                <div class="t4-contact-block">
                                    <h3>Horarios de Atención</h3>
                                    <p>Lunes a Viernes: 10 a 19hrs.</p>
                                    <p>Sábados: 11 a 14:30hrs.</p>
                                </div>

                                <div class="t4-contact-map">
                                    <iframe
                                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3329.0!2d-70.5753!3d-33.3859!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzPCsDIzJzA5LjIiUyA3MMKwMzQnMzEuMSJX!5e0!3m2!1ses!2scl!4v1700000000000"
                                        width="100%" height="280"
                                        style="border:0;"
                                        allowfullscreen=""
                                        loading="lazy"
                                        referrerpolicy="no-referrer-when-downgrade"/>
                                    <a class="t4-contact-map-link"
                                       href="https://www.google.com/maps/search/?api=1&amp;query=Luis+Pasteur+6677+Vitacura"
                                       target="_blank" rel="noopener">
                                        Pincha aquí para ampliar mapa
                                    </a>
                                </div>
                            </div>

                            <!-- Columna derecha: formulario -->
                            <div class="t4-contact-form-wrap">
                                <form action="/website_form/" method="post" enctype="multipart/form-data"
                                      class="t4-contact-form o_mark_required"
                                      data-mark="*"
                                      data-model_name="mail.mail"
                                      data-success-mode="redirect"
                                      data-success-page="/contactus-thank-you">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="email_to" value="contacto@taller4.cl"/>
                                    <input type="hidden" name="subject" value="Contacto desde web Taller4"/>

                                    <div class="t4-form-group">
                                        <label for="t4_contact_name">Nombre</label>
                                        <input type="text" id="t4_contact_name" name="name"
                                               placeholder="Nombre" required="required"/>
                                    </div>

                                    <div class="t4-form-group">
                                        <label for="t4_contact_email">Correo electrónico</label>
                                        <input type="email" id="t4_contact_email" name="email_from"
                                               placeholder="Correo electrónico" required="required"/>
                                    </div>

                                    <div class="t4-form-group">
                                        <label for="t4_contact_phone">Número de teléfono</label>
                                        <input type="tel" id="t4_contact_phone" name="phone"
                                               placeholder="Número de teléfono"/>
                                    </div>

                                    <div class="t4-form-group">
                                        <label for="t4_contact_msg">Mensaje</label>
                                        <textarea id="t4_contact_msg" name="body_html" rows="6"
                                                  placeholder="Mensaje" required="required"/>
                                    </div>

                                    <button type="submit" class="t4-contact-submit">Enviar</button>
                                </form>
                            </div>
                        </div>

                        <!-- Newsletter inferior -->
                        <div class="t4-contact-newsletter">
                            <div class="t4-contact-newsletter-text">
                                <h2>INSCRÍBETE EN NUESTRO NEWSLETTER</h2>
                                <p>¡Sé el primero en enterarte de los descuentos, beneficios y concursos!</p>
                            </div>
                            <div class="t4-contact-newsletter-form">
                                <form action="/website_mass_mailing/subscribe" method="post"
                                      class="t4-newsletter-inline">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="email" name="email" required="required"
                                           placeholder="Introduce la dirección de correo electrónico"/>
                                    <button type="submit">Unirse</button>
                                </form>
                                <div class="t4-contact-social">
                                    <a href="https://facebook.com/taller4chile" aria-label="Facebook" target="_blank" rel="noopener">
                                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 13.5h2.5l1-4H14V7c0-1 .5-2 2-2h2V1.5S16 1 14.5 1C11 1 9 3 9 6v3.5H6V13.5h3V22h5z"/></svg>
                                    </a>
                                    <a href="https://instagram.com/taller4chile" aria-label="Instagram" target="_blank" rel="noopener">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="3" width="18" height="18" rx="4"/>
                                            <circle cx="12" cy="12" r="4"/>
                                            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="t4_contacto_page_record" model="website.page">
        <field name="name">Taller4 Contacto</field>
        <field name="url">/contacto</field>
        <field name="view_id" ref="t4_contacto_page"/>
        <field name="website_id" ref="website_taller4"/>
        <field name="is_published">True</field>
    </record>
</odoo>

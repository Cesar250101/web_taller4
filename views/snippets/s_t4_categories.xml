<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_t4_categories" name="Taller4 Categorías">
        <t t-set="t4_cats" t-value="request.env['product.public.category'].sudo().search([('parent_id', '=', False)], order='sequence asc, name asc', limit=6)"/>
        <section class="s_t4_categories t4-section" data-snippet="s_t4_categories">
            <div class="t4-section-head">
                <div>
                    <div class="t4-section-eyebrow">Compra por categoría</div>
                    <h2 class="t4-section-title">Encuentra lo que <em>buscas</em></h2>
                </div>
                <a class="t4-section-link" href="/shop">
                    Ver todas
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m9 6 6 6-6 6"/>
                    </svg>
                </a>
            </div>
            <div class="t4-cats">
                <t t-foreach="t4_cats" t-as="cat">
                    <t t-set="cat_count" t-value="request.env['product.template'].sudo().search_count([('public_categ_ids', 'child_of', cat.id), ('website_published', '=', True)])"/>
                    <a class="t4-cat" t-att-href="'/shop/category/%s' % cat.id">
                        <div class="t4-cat-img">
                            <img t-att-src="'/web/image/product.public.category/%s/image_1024' % cat.id"
                                 t-att-alt="cat.name" loading="lazy"/>
                        </div>
                        <div class="t4-cat-label">
                            <div>
                                <span t-esc="cat.name"/>
                                <div class="t4-cat-count">
                                    <t t-esc="cat_count"/> productos
                                </div>
                            </div>
                            <span class="t4-cat-arrow">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="m9 6 6 6-6 6"/>
                                </svg>
                            </span>
                        </div>
                    </a>
                </t>
            </div>
        </section>
    </template>
</odoo>

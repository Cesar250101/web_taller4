<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_t4_mid_banner" name="Taller4 Banner Editorial">
        <t t-set="t4_ribbon_nuevo" t-value="request.env['product.ribbon'].sudo().search([('tipo', '=', 'nuevo')], limit=1)"/>
        <t t-set="t4_banner_img" t-value="t4_ribbon_nuevo and t4_ribbon_nuevo.imagen and ('/web/image/product.ribbon/%s/imagen' % t4_ribbon_nuevo.id) or '/web_taller4/static/src/img/banner-pyjama.jpg'"/>
        <section class="s_t4_mid_banner t4-banner" data-snippet="s_t4_mid_banner">
            <div class="t4-banner-inner">
                <div class="t4-banner-photo"
                     t-attf-style="background-image: url('{{ t4_banner_img }}');"
                     role="img"
                     aria-label="Nueva colección">
                </div>
                <div class="t4-banner-text">
                    <div class="t4-banner-eyebrow">Nueva colección</div>
                    <h2 class="t4-banner-title">Lo último que llegó,<br/>recién <em>desempacado</em>.</h2>
                    <p>Descubre las piezas que acabamos de incorporar: nuevas marcas, nuevos productos y todo lo que viene fresco al taller.</p>
                    <a href="/coleccion/nuevo" class="t4-banner-cta">
                        Ver colección
                        <svg viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 6h21M17 1l5 5-5 5"/>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
